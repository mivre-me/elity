{
  "id": "/elity/",
  "name": "Elity",
  "short_name": "Elity",
  "description": "เพื่อนและผู้ช่วยส่วนตัว เก็บประกาศ อ่านออกเสียง และโน้ตเข้ารหัส",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "audio/*",
            "video/*",
            "text/*",
            "*/*"
          ]
        }
      ]
    }
  },
  "lang": "th",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f6f4",
  "theme_color": "#0e6b58",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
